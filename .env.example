OPENAI_API_KEY=sk-...
ONSHAPE_ACCESS_KEY=...
ONSHAPE_SECRET_KEY=...
OPENAI_MODEL=gpt-6-astra
ONSHAPE_BASE_URL=https://cad.onshape.com
